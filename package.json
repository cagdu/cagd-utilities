{
  "name": "cagd-utilities",
  "version": "0.2.0",
  "description": "API, Agent vb. servislerin ortak kullandığı config / database / web yardımcı katmanı",
  "keywords": [
    "utilities",
    "config",
    "prisma",
    "express",
    "postgres",
    "mssql",
    "redis",
    "axios",
    "nodemailer",
    "typescript"
  ],
  "author": "cagdu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cagdu/cagd-utilities.git"
  },
  "bugs": {
    "url": "https://github.com/cagdu/cagd-utilities/issues"
  },
  "homepage": "https://github.com/cagdu/cagd-utilities#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./service": {
      "types": "./dist/service/index.d.ts",
      "default": "./dist/service/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "default": "./dist/services/index.js"
    },
    "./util": {
      "types": "./dist/util/index.d.ts",
      "default": "./dist/util/index.js"
    },
    "./util/http": {
      "types": "./dist/util/http/index.d.ts",
      "default": "./dist/util/http/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "node -e \"require(\\\"fs\\\").rmSync(\\\"dist\\\",{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test",
    "check": "npm run lint && npm run format:check && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "peerDependencies": {
    "@prisma/adapter-mssql": ">=6.10.0 <8",
    "@prisma/adapter-pg": ">=6.10.0 <8",
    "@prisma/client": ">=5 <8",
    "axios": ">=1",
    "cagd-log": ">=1.1.0 <2",
    "cors": ">=2",
    "express": ">=4",
    "express-rate-limit": ">=7",
    "helmet": ">=7",
    "mssql": ">=10",
    "nodemailer": ">=6",
    "pg": ">=8",
    "redis": ">=4"
  },
  "peerDependenciesMeta": {
    "@prisma/adapter-mssql": {
      "optional": true
    },
    "@prisma/adapter-pg": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "axios": {
      "optional": true
    },
    "cagd-log": {
      "optional": true
    },
    "cors": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "express-rate-limit": {
      "optional": true
    },
    "helmet": {
      "optional": true
    },
    "mssql": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@prisma/adapter-mssql": "^7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.10",
    "axios": "^1.7.7",
    "cagd-log": "1.1.0",
    "cors": "^2.8.5",
    "eslint": "^9.39.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "globals": "^17.12.0",
    "helmet": "^8.0.0",
    "mssql": "^12.7.2",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.1",
    "prettier": "^3.9.9",
    "redis": "^4.7.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "zod": "^4.6.5"
  },
  "typesVersions": {
    "*": {
      "config": [
        "dist/config/index.d.ts"
      ],
      "service": [
        "dist/service/index.d.ts"
      ],
      "services": [
        "dist/services/index.d.ts"
      ],
      "util": [
        "dist/util/index.d.ts"
      ],
      "util/http": [
        "dist/util/http/index.d.ts"
      ]
    }
  }
}
